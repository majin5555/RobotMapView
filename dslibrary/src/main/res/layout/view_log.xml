<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/log_top_container"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_edit"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:drawablePadding="6dp"
            android:drawableTint="#5672FF"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="80dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="编辑"
            android:textColor="#5672FF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_select_all"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:drawablePadding="6dp"
            android:drawableTint="#5672FF"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="80dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="全选"
            android:textColor="#5672FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_edit"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_delete"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:drawablePadding="6dp"
            android:drawableTint="#FF6D64"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="80dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="删除"
            android:textColor="#FF6D64"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_select_all"
            app:layout_constraintTop_toTopOf="parent" />

        <CheckBox
            android:id="@+id/check_error_msg"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="20dp"
            android:buttonTint="#FF6D64"
            android:checked="true"
            android:gravity="center_vertical"
            android:minWidth="90dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:text="故障信息"
            android:textColor="#FF6D64"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/check_warn_msg"
            app:layout_constraintTop_toTopOf="parent" />


        <CheckBox
            android:id="@+id/check_warn_msg"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:buttonTint="#E7B447"
            android:checked="true"
            android:gravity="center_vertical"
            android:minWidth="90dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:text="告警信息"
            android:textColor="#E7B447"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_system_log"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/log_top_container" />

</androidx.constraintlayout.widget.ConstraintLayout>
