<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_title"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:text="TITLE"
        android:gravity="center"
        android:background="#00ff00"
        android:layout_height="100dp"/>

    <!--显示地图的View-->
    <com.siasun.dianshi.view.createMap.map3D.CreateMapView3D
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvMapSteps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="建图步数"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="定位状态" />

    <Button
        android:id="@+id/btn_show_key_frame"
        android:layout_width="160dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:text="显示关键帧" />


    <Button
        android:id="@+id/btn_location"
        android:layout_width="160dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_show_key_frame"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:text="定位" />

    <Button
        android:id="@+id/btn_setting_area"
        android:layout_width="160dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_location"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:text="设置区域" />

    <Button
        android:id="@+id/btn_clean_area"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/btn_setting_area"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:text="清除区域" />

    <Button
        android:id="@+id/tv_save"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="保存地图"
        app:layout_constraintTop_toBottomOf="@+id/btn_clean_area"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/tv_stop"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="结束扫描"
        app:layout_constraintTop_toBottomOf="@+id/tv_save"
        app:layout_constraintEnd_toEndOf="parent"  />


    <Button
        android:id="@+id/tv_expend"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="扩展地图"
        app:layout_constraintTop_toBottomOf="@+id/tv_stop"
        app:layout_constraintEnd_toEndOf="parent"  />

    <Button
        android:id="@+id/tv_update"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="更新地图"
        app:layout_constraintTop_toBottomOf="@+id/tv_expend"
        app:layout_constraintEnd_toEndOf="parent"  />

    <!-- 旋转-->
<!--    <LinearLayout-->
<!--        android:id="@+id/ll_rotate"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="0dp"-->
<!--        android:orientation="vertical"-->
<!--        app:layout_constraintTop_toBottomOf="@+id/tv_title"-->
<!--        app:layout_constraintBottom_toBottomOf="parent"-->
<!--        app:layout_constraintEnd_toEndOf="parent">-->



<!--       -->


<!--    </LinearLayout>-->


</androidx.constraintlayout.widget.ConstraintLayout>